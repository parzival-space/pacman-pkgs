# Originally based on CachyOS Gaming Meta package

pkgname=parzival-gaming-meta
pkgver=1.0.0
pkgrel=1
arch=(any)
pkgdesc='Meta package for Gaming dependencies'
depends=(
  alsa-plugins
  giflib
  glfw
  gst-plugins-base-libs
  lib32-alsa-plugins
  lib32-giflib
  lib32-gst-plugins-base-libs
  lib32-gtk3
  lib32-libjpeg-turbo
  lib32-libva
  lib32-mpg123
  lib32-ocl-icd
  lib32-opencl-icd-loader
  lib32-openal
  libjpeg-turbo
  libva
  libxslt
  mpg123
  opencl-icd-loader
  openal
  umu-launcher
  protontricks
  ttf-liberation
  wine
  wine-mono
  wine-gecko
  winetricks
  vulkan-tools
)

source=('99-splitlock.conf')
sha256sums=('914ea1821511fc9f1f4c6f981e727ff4eab3ede4fe4ee4d813f6ec53f6def212')

package() {
  install -Dm644 "$srcdir/99-splitlock.conf" "$pkgdir/usr/lib/sysctl.d/99-splitlock.conf"
}